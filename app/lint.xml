<?xml version="1.0" encoding="UTF-8"?>
<!--
    app/lint.xml — Android lint 配置。

    本工程文案全部内联在布局 XML / Java（不抽取到 strings.xml）是既有约定，
    这里只把这些「预期噪声」检查从 error 降为 warning，避免 lintDebug 被它们阻断；
    其余检查项一律沿用 lint 默认 severity，不在本文件覆盖。
-->
<lint>
    <!-- 文案内联在 XML/Java 中，属项目既有约定，降为 warning -->
    <issue id="HardcodedText" severity="warning" />

    <!-- 暂未提供独立的 application launcher icon，降为 warning -->
    <issue id="MissingApplicationIcon" severity="warning" />

    <!-- ImageView 的 contentDescription 由业务按需补充，降为 warning -->
    <issue id="ContentDescription" severity="warning" />

    <!--
        UnsafeOptInUsageError、NewApi 等 API 级别 / 实验性 API 检查保持默认
        severity（不在此配置），以便继续暴露兼容性问题；
        checkDependencies 未启用，仅检查本模块自身。
    -->
</lint>
