<?xml version="1.0" encoding="utf-8"?>
<!-- 进全屏播放：从 0.92 放大到 1，配合淡入。播放器本身在详情页顶部 16:9，
     全屏是旋转＋铺满，用「放大 + 淡入」接住，比系统默认的左右滑更接近"画面撑开"的观感。 -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="220" />
    <scale
        android:fromXScale="0.92"
        android:toXScale="1"
        android:fromYScale="0.92"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="260" />
</set>
