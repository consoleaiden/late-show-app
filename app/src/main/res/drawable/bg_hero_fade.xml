<?xml version="1.0" encoding="utf-8"?>
<!-- 海报底部渐变：顶部全透明 → 中部半透明 → 底部完全不透明，落点 = 信息带底色 @color/heroBand。
     angle=270 = 从上到下；三个色值都定义在 values/values-night 的 colors.xml（heroBand*）。
     改信息带底色时只要改 heroBand*，渐变与底色永远同源，不会出现色阶断层。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/heroBandFade"
        android:centerColor="@color/heroBandMid"
        android:endColor="@color/heroBand"
        android:type="linear" />
</shape>
