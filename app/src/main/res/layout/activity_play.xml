<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页：顶部海报（满宽 × 半屏，底部渐变到主题底色）+ 信息模块 + 简介/选集/推荐。
     返回按钮已移除，返回统一走系统侧滑 / 返回键（PlayActivity 的 OnBackPressedCallback 接管动画）。
     整页底色用 @color/heroBg（海报渐变落点），换肤时只需改这一个色值，渐变与页面永远同色。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/heroBg">

    <ScrollView
        android:id="@+id/scrollPlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 内嵌播放器（点「播放」在当前页播放，点全屏按钮才进入横屏全屏）。
                 播放时替换海报区，出现在页面最顶部 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/playerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:visibility="gone">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="16:9"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:surface_type="surface_view"
                    app:show_buffering="when_playing" />

                <TextView
                    android:id="@+id/seekOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/bg_chip_dark"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 播放器工具：倍速 + 设置（始终悬浮在右上角） -->
                <LinearLayout
                    android:id="@+id/playerTools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/btnSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:background="@drawable/bg_chip_dark"
                        android:alpha="0.85"
                        android:text="1.0x"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:contentDescription="倍速" />

                    <TextView
                        android:id="@+id/btnGear"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginLeft="6dp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_dark"
                        android:alpha="0.85"
                        android:text="⚙"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:contentDescription="播放设置" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 海报区：横向满屏、纵向半屏（高度在 PlayActivity 里按屏幕高度的一半设定）。
                 图片 centerCrop 铺满，底部 heroFade 由透明渐变到 @color/heroBg，
                 与下方信息模块同色衔接，没有硬边 -->
            <FrameLayout
                android:id="@+id/heroWrap"
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/ink700"
                    android:scaleType="centerCrop"
                    android:contentDescription="海报" />

                <View
                    android:id="@+id/heroFade"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_fade" />

                <FrameLayout
                    android:id="@+id/btnPlayCover"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_cover">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/imgPlayCover"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:tag="ic_play" />
                </FrameLayout>
            </FrameLayout>

            <!-- 信息模块：源站 / 更新信息 / 片名 / 分类·日期 / 演员 / 标签（一个整体，紧贴渐变落点） -->
            <LinearLayout
                android:id="@+id/infoModule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 两个胶囊并排：各自限宽 + 省略号，窄屏也不会把更新信息挤出屏幕 -->
                    <TextView
                        android:id="@+id/chipSource"
                        style="@style/HeroChip"
                        android:maxWidth="160dp"
                        android:background="@drawable/bg_capsule"
                        android:drawableStart="@drawable/dot_acc"
                        android:drawablePadding="6dp"
                        android:textColor="@color/t1" />

                    <TextView
                        android:id="@+id/chipUpdate"
                        style="@style/HeroChip"
                        android:layout_marginLeft="8dp"
                        android:maxWidth="130dp"
                        android:background="@drawable/bg_capsule"
                        android:textColor="@color/accText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/t1"
                    android:lineSpacingMultiplier="1.18"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvMeta"
                    style="@style/MetaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="" />

                <!-- 演员：vod_actor 缺失时用服务端 star_map 命中的明星集兜底，仍为空则整行隐藏 -->
                <LinearLayout
                    android:id="@+id/rowActor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/MetaLabel"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="演员" />

                    <TextView
                        android:id="@+id/tvActor"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="12.5sp"
                        android:textColor="@color/t2"
                        android:lineSpacingMultiplier="1.5"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- 标签：横向可滚动（标签数量不定，不换行挤压模块高度） -->
                <LinearLayout
                    android:id="@+id/rowTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/MetaLabel"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="标签" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/tagRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== 以下内容与顺序保持原样 ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="13sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.78"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btnToggleDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="展开简介"
                    android:textSize="12sp"
                    android:textColor="@color/accText" />

                <!-- 操作行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_main"
                        android:text="播放 · 第 1 集"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accInk"
                        android:letterSpacing="0.06" />

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/btnFav"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginLeft="10dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_smbtn"
                        android:tag="ic_heart"
                        android:contentDescription="收藏" />
                </LinearLayout>

                <!-- 线路选择（多线路时显示） -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false" />

                <!-- 选集 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1" />

                    <TextView
                        android:id="@+id/epCount"
                        style="@style/MetaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- 集" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/epGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <!-- 相关推荐：横向滚动。数据来自 VodSync v1.9.0 预计算（直连模式用同分类兜底） -->
                <LinearLayout
                    android:id="@+id/relatedSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="相关推荐"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/t1" />

                        <TextView
                            android:id="@+id/tvRelatedHint"
                            style="@style/MetaLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/relatedList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <!-- 相同演员作品：明星 Tab + 横向影片卡（VodSync v1.9.1 /api/v1/star/related，
                     一次拉取后客户端按 match_stars 本地分组切换 Tab，不再发请求） -->
                <LinearLayout
                    android:id="@+id/castSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="相同演员作品"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/t1" />

                        <TextView
                            android:id="@+id/tvCastHint"
                            style="@style/MetaLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/castTabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/castList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
