<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 返回栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="12dp"
            android:background="@drawable/bg_capsule"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="2dp"
            android:text="返回"
            android:textSize="12sp"
            android:textColor="@color/t1" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/breadcrumb"
            style="@style/MetaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETAIL" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 内嵌播放器（点「播放」在当前页播放，点全屏按钮才进入横屏全屏） -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/playerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:visibility="gone">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="16:9"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:surface_type="surface_view"
                    app:show_buffering="when_playing" />

                <TextView
                    android:id="@+id/seekOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/bg_chip_dark"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 竖版海报 + 标题信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="14dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/posterBox"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/cover"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        android:background="@color/ink700"
                        app:layout_constraintDimensionRatio="9:16"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:background="@drawable/cover_fade"
                        app:layout_constraintBottom_toBottomOf="@id/cover"
                        app:layout_constraintStart_toStartOf="@id/cover"
                        app:layout_constraintEnd_toEndOf="@id/cover" />

                    <FrameLayout
                        android:id="@+id/btnPlayCover"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle"
                        app:layout_constraintTop_toTopOf="@id/cover"
                        app:layout_constraintBottom_toBottomOf="@id/cover"
                        app:layout_constraintStart_toStartOf="@id/cover"
                        app:layout_constraintEnd_toEndOf="@id/cover">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_play" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/badge"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:background="@drawable/bg_capsule"
                        android:drawableStart="@drawable/dot_acc"
                        android:drawablePadding="6dp"
                        style="@style/MetaLabel"
                        android:text="详情" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMeta"
                        style="@style/MetaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="12.5sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.78"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btnToggleDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="展开简介"
                    android:textSize="11sp"
                    android:textColor="@color/acc" />

                <!-- 操作行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_main"
                        android:text="播放 · 第 1 集"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accInk"
                        android:letterSpacing="0.06" />

                    <ImageButton
                        android:id="@+id/btnFav"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginLeft="10dp"
                        android:background="@drawable/bg_smbtn"
                        android:src="@drawable/ic_bookmark"
                        android:contentDescription="收藏" />
                </LinearLayout>

                <!-- 线路选择（多线路时显示） -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false" />

                <!-- 选集 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1" />

                    <TextView
                        android:id="@+id/epCount"
                        style="@style/MetaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- 集" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/epGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
