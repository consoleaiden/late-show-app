<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 返回栏：箭头图形在 ic_back 素材 24x24 画布里从 x=7 开始（36dp 内容盒中占 10.5dp），
         左内边距 5.5dp 让箭头视觉左缘落在 16dp，与下方海报（16dp）精确对齐；
         右内边距 26.5dp 保持内容盒仍为 36dp，箭头不缩放，触控区仍是整块 68dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="0dp"
        android:paddingRight="16dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/btnBack"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:paddingLeft="5.5dp"
            android:paddingTop="16dp"
            android:paddingRight="26.5dp"
            android:paddingBottom="16dp"
            android:background="@null"
            android:tag="ic_back"
            android:contentDescription="返回" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/breadcrumb"
            style="@style/MetaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETAIL" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 内嵌播放器（点「播放」在当前页播放，点全屏按钮才进入横屏全屏） -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/playerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:visibility="gone">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="16:9"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:surface_type="surface_view"
                    app:show_buffering="when_playing" />

                <TextView
                    android:id="@+id/seekOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/bg_chip_dark"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 播放器工具：倍速 + 设置（始终悬浮在右上角） -->
                <LinearLayout
                    android:id="@+id/playerTools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/btnSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:background="@drawable/bg_chip_dark"
                        android:alpha="0.85"
                        android:text="1.0x"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:contentDescription="倍速" />

                    <TextView
                        android:id="@+id/btnGear"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginLeft="6dp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_dark"
                        android:alpha="0.85"
                        android:text="⚙"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:contentDescription="播放设置" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 竖版海报 + 标题信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="14dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/posterBox"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cover_round_lg"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/cover"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.LateShow.CoverLg"
                        app:layout_constraintDimensionRatio="9:16"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:background="@drawable/cover_fade_round"
                        app:layout_constraintBottom_toBottomOf="@id/cover"
                        app:layout_constraintStart_toStartOf="@id/cover"
                        app:layout_constraintEnd_toEndOf="@id/cover" />

                    <FrameLayout
                        android:id="@+id/btnPlayCover"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_play_cover"
                        app:layout_constraintTop_toTopOf="@id/cover"
                        app:layout_constraintBottom_toBottomOf="@id/cover"
                        app:layout_constraintStart_toStartOf="@id/cover"
                        app:layout_constraintEnd_toEndOf="@id/cover">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/imgPlayCover"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:tag="ic_play" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/infoCol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/badge"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:background="@drawable/bg_capsule"
                        android:drawableStart="@drawable/dot_acc"
                        android:drawablePadding="6dp"
                        style="@style/MetaLabel"
                        android:text="详情" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMeta"
                        style="@style/MetaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="13sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.78"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btnToggleDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="展开简介"
                    android:textSize="12sp"
                    android:textColor="@color/accText" />

                <!-- 操作行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_main"
                        android:text="播放 · 第 1 集"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accInk"
                        android:letterSpacing="0.06" />

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/btnFav"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginLeft="10dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_smbtn"
                        android:tag="ic_heart"
                        android:contentDescription="收藏" />
                </LinearLayout>

                <!-- 线路选择（多线路时显示） -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false" />

                <!-- 选集 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/t1" />

                    <TextView
                        android:id="@+id/epCount"
                        style="@style/MetaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- 集" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/epGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
