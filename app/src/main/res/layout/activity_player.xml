<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing" />

    <!-- 滑动进度预览 -->
    <TextView
        android:id="@+id/seekOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_chip_dark"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- 退出全屏返回按钮（左上角悬浮）：按钮 80→53dp（缩小 1/3），图标 52→41.6dp（缩小 1/5，padding 6dp） -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/btnBackFull"
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="6dp"
        android:layout_marginStart="8dp"
        android:padding="6dp"
        android:background="@drawable/bg_player_back"
        android:tag="ic_back"
        android:contentDescription="退出全屏" />

    <!-- 播放器工具：倍速 + 设置（右上角悬浮）。
         外层 FrameLayout 承载液态玻璃层（bind playerView，折射视频画面），
         内层 LinearLayout 是原来的胶囊按钮。 -->
    <FrameLayout
        android:id="@+id/playerTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="10dp">

        <com.qmdeve.liquidglass.widget.LiquidGlassView
            android:id="@+id/glassPlayerTools"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="@drawable/bg_chip_dark"
                android:alpha="0.85"
                android:text="1.0x"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace"
                android:contentDescription="倍速" />

            <TextView
                android:id="@+id/btnGear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginLeft="6dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_dark"
                android:alpha="0.85"
                android:text="⚙"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:contentDescription="播放设置" />
        </LinearLayout>
    </FrameLayout>

    <!-- 播放地址 / 下载工具条：默认隐藏，由设置页「播放偏好」开关控制 -->
    <include
        layout="@layout/view_stream_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp" />
</FrameLayout>
