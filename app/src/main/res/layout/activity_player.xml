<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing" />

    <!-- 滑动进度预览 -->
    <TextView
        android:id="@+id/seekOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_chip_dark"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- 退出全屏返回按钮（左上角悬浮，白色箭头与倍速文字同色） -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/btnBackFull"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="22dp"
        android:layout_marginStart="10dp"
        android:padding="7dp"
        android:background="@drawable/bg_chip_dark"
        android:alpha="0.85"
        android:tag="ic_back"
        android:contentDescription="退出全屏" />

    <!-- 播放器工具：倍速 + 设置（右上角悬浮） -->
    <LinearLayout
        android:id="@+id/playerTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSpeed"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@drawable/bg_chip_dark"
            android:alpha="0.85"
            android:text="1.0x"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:contentDescription="倍速" />

        <TextView
            android:id="@+id/btnGear"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_dark"
            android:alpha="0.85"
            android:text="⚙"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:contentDescription="播放设置" />
    </LinearLayout>
</FrameLayout>
