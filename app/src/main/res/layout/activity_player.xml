<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing" />

    <!-- 滑动进度预览 -->
    <TextView
        android:id="@+id/seekOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_chip_dark"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- 退出全屏返回按钮（左上角悬浮）：按钮 80→53dp（缩小 1/3），图标 52→41.6dp（缩小 1/5，padding 6dp） -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnBackFull"
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="6dp"
        android:layout_marginStart="8dp"
        android:padding="6dp"
        android:background="@drawable/bg_player_back"
        android:src="@drawable/ic_back"
        android:contentDescription="退出全屏" />

    <!-- 播放器工具：设置（聚合面板，倍速等已并入；右上角悬浮） -->
    <LinearLayout
        android:id="@+id/playerTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnGear"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_dark"
            android:alpha="0.85"
            android:text="⚙"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:contentDescription="播放设置" />
    </LinearLayout>

    <!-- 播放地址 / 下载工具条：默认隐藏，由设置页「播放偏好」开关控制。
         位置贴屏幕底部、留出控制条高度（约 72dp），原来放在顶部 64dp 处浮在半空很难找。 -->
    <include
        layout="@layout/view_stream_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="72dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp" />
</FrameLayout>
