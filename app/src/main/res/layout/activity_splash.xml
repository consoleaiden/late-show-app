<?xml version="1.0" encoding="utf-8"?>
<!-- 方寸开屏：暗场海报编排（描框 → 绘三角 → 题字 → 标语），编排由 SplashActivity 驱动。
     底色恒为品牌暖墨（两种主题下一致，品牌开屏即暗场）。任意点击可跳过。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brandInk"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/splashMark"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:scaleType="fitCenter"
            android:contentDescription="方寸字标" />

        <!-- 题字：宋体栈（品牌字体规范，系统缺宋体时回退衬线） -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="方寸"
            android:fontFamily="serif"
            android:textSize="44sp"
            android:letterSpacing="0.35"
            android:includeFontPadding="false"
            android:textColor="@color/brandPaper"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="方寸之间，万象银幕"
            android:textSize="12sp"
            android:letterSpacing="0.42"
            android:textColor="@color/brandPaper"
            android:alpha="0" />
    </LinearLayout>
</FrameLayout>
