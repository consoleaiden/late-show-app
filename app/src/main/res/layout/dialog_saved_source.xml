<?xml version="1.0" encoding="utf-8"?>
<!-- 编辑「已保存播放源」专用表单。
     字段顺序固定：播放源名称 → 播放源 URL 地址 → API Token（与需求一致）。
     不再复用 dialog_custom_source：那个是「自定义源站」表单，字段语义与顺序都不同，
     复用会导致隐藏字段后顺序语义含混。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/MetaLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="播放源名称" />

    <EditText
        android:id="@+id/dssName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/bg_field"
        android:hint="例如：家里 NAS"
        android:textSize="12sp"
        android:textColor="@color/t1"
        android:textColorHint="@color/t3"
        android:inputType="text"
        android:maxLines="1" />

    <TextView
        style="@style/MetaLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="播放源 URL 地址" />

    <EditText
        android:id="@+id/dssUrl"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/bg_field"
        android:hint="http:// 或 https:// 开头"
        android:textSize="12sp"
        android:textColor="@color/t1"
        android:textColorHint="@color/t3"
        android:inputType="textUri"
        android:maxLines="1" />

    <TextView
        style="@style/MetaLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="API Token" />

    <EditText
        android:id="@+id/dssToken"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/bg_field"
        android:hint="服务端未开启鉴权可留空"
        android:textSize="12sp"
        android:textColor="@color/t1"
        android:textColorHint="@color/t3"
        android:inputType="textVisiblePassword"
        android:maxLines="1" />

    <TextView
        style="@style/MetaLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:textAllCaps="false"
        android:text="保存后保持该条目在列表中的位置；若改成已存在的地址，会合并为一条。"
        android:lineSpacingMultiplier="1.4" />
</LinearLayout>
