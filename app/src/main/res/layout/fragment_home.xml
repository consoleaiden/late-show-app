<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：根 FrameLayout，网格铺满全高（顶部留 64dp），内容从玻璃顶栏后面穿过。
     顶栏 = 液态玻璃悬浮胶囊（与底部导航同一套实现 + 三级平滑降级）：
     [源站按钮] [分类横滑（长按弹全部分类）] [搜索按钮]
     搜索输入框默认隐藏，点搜索按钮从右向左滑出，提交或收起后自动隐藏。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingTop="64dp"
        android:paddingBottom="64dp"
        android:clipToPadding="false" />

    <!-- 首屏骨架屏：首次加载且列表为空时显示，避免白屏「假死」 -->
    <LinearLayout
        android:id="@+id/skeletonBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="64dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- 搜索历史面板：搜索框展开时浮在顶栏下方（不再挤压列表流） -->
    <LinearLayout
        android:id="@+id/histPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="58dp"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_card_lg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="搜索历史" />

            <TextView
                android:id="@+id/histCount"
                style="@style/MetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/histPage"
                style="@style/MetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/histEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="暂无搜索历史 · 输入关键词后按搜索键记录"
            android:textSize="10.5sp"
            android:textColor="@color/t3"
            android:lineSpacingMultiplier="1.6"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/histBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/histPager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/histPrev"
                style="@style/Smbtn"
                android:text="‹ 上一页" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/histNext"
                style="@style/Smbtn"
                android:text="下一页 ›" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnClearHist"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:background="@drawable/bg_smbtn"
            android:text="清空历史"
            android:textSize="12sp"
            android:textColor="@color/bad"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 回到顶部浮动按钮：底部 margin 72dp 清开玻璃导航胶囊 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="72dp"
        app:fabCustomSize="40dp"
        android:src="@drawable/ic_top"
        app:tint="@color/t1"
        app:maxImageSize="20dp"
        app:backgroundTint="@color/ink700"
        app:elevation="6dp"
        android:contentDescription="回到顶部"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="换个关键词试试\n试试片名、演员，或切回「全部」"
        android:textSize="13sp"
        android:textColor="@color/t2"
        android:visibility="gone" />

    <!-- 源站 / 全部分类 的玻璃弹层：页面内浮层（不是独立 Window），
         这样才能真实采样背后滚动的海报做液态玻璃；宽度 = 源站列表原宽 250dp 的 3/4。
         层级在列表之上、玻璃顶栏之下，所以打开时顶栏仍可点。 -->
    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- 全屏透明遮罩：点任意空白处关闭 -->
        <View
            android:id="@+id/menuScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.lateshow.app.ui.widget.LiquidGlassPanel
            android:id="@+id/menuPanel"
            android:layout_width="188dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="58dp" />
    </FrameLayout>

    <!-- 顶部液态玻璃栏：与底部导航同一实现（LiquidGlassBar 三级降级）。
         结构：单个全宽叠加层 —— 分类横滑铺满胶囊内部（正边距 51↔4dp，永不越过胶囊圆角），
         两侧渐变遮罩盖住分类的裁切缘，源站/搜索按钮叠在分类上层、滑出即离开可视区 -->
    <com.lateshow.app.ui.widget.LiquidGlassBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 分类横滑：静止时两边距 51dp（按钮 38 + 边距 5/8 + 间隙 8），横滑时收窄到 4dp -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="51dp"
                android:layout_marginRight="51dp"
                android:overScrollMode="never"
                android:clipToPadding="false" />

            <!-- 两侧渐变遮罩：盖住分类在自身边缘被裁切的部分，随分类边距同节奏移动 -->
            <View
                android:id="@+id/fadeL"
                android:layout_width="13dp"
                android:layout_height="36dp"
                android:layout_gravity="left|center_vertical"
                android:layout_marginLeft="51dp"
                android:background="@drawable/fade_edge_left" />

            <View
                android:id="@+id/fadeR"
                android:layout_width="13dp"
                android:layout_height="36dp"
                android:layout_gravity="right|center_vertical"
                android:layout_marginRight="51dp"
                android:background="@drawable/fade_edge_right" />

            <FrameLayout
                android:id="@+id/btnSource"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="left|center_vertical"
                android:layout_marginLeft="5dp"
                android:background="@drawable/bg_ring_off"
                android:contentDescription="切换源站">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnSourceIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_list"
                    android:contentDescription="源站菜单" />
            </FrameLayout>

            <!-- 搜索输入：默认隐藏，点搜索按钮从右向左滑出盖住分类区 -->
            <FrameLayout
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="51dp"
                android:layout_marginRight="51dp"
                android:background="@drawable/bg_capsule"
                android:visibility="gone">

                <EditText
                    android:id="@+id/inputSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="12dp"
                    android:paddingRight="34dp"
                    android:background="@null"
                    android:hint="搜片名 / 演员"
                    android:textSize="13sp"
                    android:textColor="@color/t1"
                    android:textColorHint="@color/t3"
                    android:maxLines="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />

                <TextView
                    android:id="@+id/btnSearchClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="14sp"
                    android:textColor="@color/t3"
                    android:contentDescription="收起搜索" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="right|center_vertical"
                android:layout_marginRight="5dp"
                android:contentDescription="搜索">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgSearch"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search" />
            </FrameLayout>
        </FrameLayout>
    </com.lateshow.app.ui.widget.LiquidGlassBar>
</FrameLayout>
