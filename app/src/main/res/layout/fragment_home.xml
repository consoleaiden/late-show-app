<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶栏：源站菜单（圆形按钮 + 圆环=后端连通状态） + 搜索框；左右外边距与下方海报列表对齐（5dp） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/btnSource"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_ring_off"
            android:contentDescription="切换源站">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/btnSourceIcon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:tag="ic_menu_list"
                android:contentDescription="源站菜单" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_capsule">

            <EditText
                android:id="@+id/inputSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="12dp"
                android:paddingRight="38dp"
                android:background="@null"
                android:hint="搜片名 / 演员"
                android:textSize="12.5sp"
                android:textColor="@color/t1"
                android:textColorHint="@color/t3"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/imgSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:tag="ic_search" />
        </FrameLayout>
    </LinearLayout>

    <!-- 分类横滑 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chips"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:overScrollMode="never"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:clipToPadding="false" />

    <!-- 元信息条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/metaCount"
            style="@style/MetaLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="已收录 -- 部" />

        <TextView
            android:id="@+id/metaSync"
            style="@style/MetaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● -- 同步" />
    </LinearLayout>

    <!-- 卡片墙：两边不留白，卡片自带左右间距；FrameLayout 容纳回到顶部浮动按钮 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:clipToPadding="false" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            app:fabCustomSize="40dp"
            app:maxImageSize="20dp"
            app:backgroundTint="@color/ink700"
            app:elevation="6dp"
            android:contentDescription="回到顶部"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="换个关键词试试\n试试片名、演员，或切回「全部」"
        android:textSize="13sp"
        android:textColor="@color/t2"
        android:visibility="gone" />
</LinearLayout>
