<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <!-- 页头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/t1" />

                <TextView
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="同步与播放偏好" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTheme"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle"
                android:src="@drawable/ic_theme"
                android:contentDescription="主题" />
        </LinearLayout>

        <!-- ① 播放源 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="播放源" />

                <TextView
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="SOURCE" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="VodSync 后端地址，保存后全站接口即时生效。"
                android:textSize="10.5sp"
                android:textColor="@color/t2"
                android:lineSpacingMultiplier="1.6" />

            <EditText
                android:id="@+id/inputBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="@drawable/bg_field"
                android:textSize="12sp"
                android:textColor="@color/t1"
                android:inputType="textUri"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API Token" />

                <TextView
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="鉴权" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="服务端 v1.5.0+ 默认开启访问控制。在浏览器打开服务面板 → 登录 → 右上角「⚙ 设置」→ 复制 API Token 粘贴到这里。服务器未开启鉴权时可留空。"
                android:textSize="10.5sp"
                android:textColor="@color/t2"
                android:lineSpacingMultiplier="1.6" />

            <EditText
                android:id="@+id/inputToken"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="@drawable/bg_field"
                android:hint="vs_xxxxxxxxxxxx"
                android:textSize="12sp"
                android:textColor="@color/t1"
                android:textColorHint="@color/t3"
                android:inputType="textVisiblePassword"
                android:maxLines="1" />

            <TextView
                android:id="@+id/srcStatus"
                style="@style/MetaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="● 未检测" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_main"
                    android:text="保存"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accInk"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/btnTest"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginLeft="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_smbtn"
                    android:text="测试连接"
                    android:textSize="13sp"
                    android:textColor="@color/t1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ② 播放偏好：跳过片头/片尾 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="播放偏好" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="跳过片头：新视频从设定的秒数开始播放（用于跳过片头广告）；跳过片尾：播放到结尾前设定的秒数时自动结束。填 0 表示不跳过，改动即时生效。"
                android:textSize="10.5sp"
                android:textColor="@color/t2"
                android:lineSpacingMultiplier="1.6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputSkipIntro"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:background="@drawable/bg_field"
                    android:hint="跳过片头（秒）"
                    android:textSize="12sp"
                    android:textColor="@color/t1"
                    android:textColorHint="@color/t3"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/inputSkipEnding"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginLeft="10dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:background="@drawable/bg_field"
                    android:hint="跳过片尾（秒）"
                    android:textSize="12sp"
                    android:textColor="@color/t1"
                    android:textColorHint="@color/t3"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ③ 离线与缓存 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="离线与缓存" />

            <TextView
                android:id="@+id/tvCacheInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="统计中…"
                android:textSize="11sp"
                android:textColor="@color/t2"
                android:lineSpacingMultiplier="1.5" />

            <TextView
                android:id="@+id/btnClearCache"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:background="@drawable/bg_smbtn"
                android:text="清除首页 / 分类 / 源站缓存"
                android:textSize="12sp"
                android:textColor="@color/t1" />
        </LinearLayout>

        <!-- ④ 运行概览 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="运行概览" />

            <LinearLayout
                android:id="@+id/statsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ⑤ 同步操作 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="同步操作" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSyncAll"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_main"
                    android:text="全站增量同步"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accInk" />

                <TextView
                    android:id="@+id/btnRefresh"
                    style="@style/OpBtn" android:text="刷新源站列表" android:layout_marginLeft="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnFullSync"
                    style="@style/OpBtn" android:text="全站全量同步" />

                <TextView
                    android:id="@+id/btnRecount"
                    style="@style/OpBtn" android:text="条数校准" android:layout_marginLeft="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="全量同步仅建议数据异常时使用，耗时较长且会重跑全部页码。"
                android:textSize="10.5sp"
                android:textColor="@color/warn"
                android:lineSpacingMultiplier="1.6" />
        </LinearLayout>

        <!-- ④ 同步暂停 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="同步暂停" />

            <TextView
                android:id="@+id/pauseWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:background="@color/warnSoft"
                android:textSize="10.5sp"
                android:textColor="@color/warn"
                android:lineSpacingMultiplier="1.6"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pauseRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ⑤ 源站同步状态 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="源站同步状态" />

                <TextView
                    android:id="@+id/autoCount"
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动同步 --/--" />
            </LinearLayout>

            <!-- 批量工具条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/chkAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全选"
                    android:textSize="11sp"
                    android:textColor="@color/t2" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView android:id="@+id/btnAllOn" style="@style/Smbtn" android:text="全部开启" />
                <TextView android:id="@+id/btnAllOff" style="@style/Smbtn" android:layout_marginLeft="6dp" android:text="全部暂停" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/selCount"
                    style="@style/MetaLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="未选择源站" />

                <TextView android:id="@+id/btnSelOn" style="@style/Smbtn" android:text="开启所选" />
                <TextView android:id="@+id/btnSelOff" style="@style/Smbtn" android:layout_marginLeft="6dp" android:text="暂停所选" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/srcList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ⑥ 最近同步日志 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最近同步日志" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/logList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ⑦ 应用更新 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="应用更新" />

                <TextView
                    android:id="@+id/tvVersion"
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v--" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUpdateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="读取 GitHub Release 最新版本，可直接下载安装。"
                android:textSize="10.5sp"
                android:textColor="@color/t2"
                android:lineSpacingMultiplier="1.6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_main"
                    android:text="检查更新"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accInk" />

                <TextView
                    android:id="@+id/btnReleasePage"
                    style="@style/OpBtn"
                    android:layout_marginLeft="8dp"
                    android:text="发布历史" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/MetaLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:text="夜场 LATE SHOW · 开源影视聚合客户端" />
    </LinearLayout>
</ScrollView>
