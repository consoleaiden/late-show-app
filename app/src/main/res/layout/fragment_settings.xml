<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="88dp">

        <!-- 页头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/t1" />

                <TextView
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="同步与播放偏好" />
            </LinearLayout>

            <com.lateshow.app.util.ThemeToggleIcon
                android:id="@+id/btnTheme"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:background="@drawable/bg_circle"
                android:tag="ic_theme"
                android:contentDescription="主题" />
        </LinearLayout>

        <!-- ① 数据源模式：NAS 同步库 / 资源站直连（手风琴面板，与其他模块一致） -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hdrMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@null">

                <ImageView
                    android:id="@+id/icModeHeader"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="7dp"
                    android:src="@drawable/ic_set_mode"
                    app:tint="@color/t3"
                    android:contentDescription="数据源模式" />

                <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="数据源模式" />

                <TextView style="@style/MetaLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:text="MODE" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvModeState"
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/arMode"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:tag="ic_chevron_down"
                    app:tint="@color/t3"
                    android:contentDescription="展开" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_capsule"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/segModeSync"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="NAS 同步库"
                        android:textSize="12sp"
                        android:textColor="@color/accInk"
                        android:background="@drawable/bg_seg_on" />

                    <TextView
                        android:id="@+id/segModeStatic"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="资源站直连"
                        android:textSize="12sp"
                        android:textColor="@color/t2" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvModeDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="10.5sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.6"
                    android:text="NAS 同步库：走自己的 VodSync 聚合库，速度快、数据全，需要 NAS 在线。\n资源站直连：从公开资源站目录直接取片，NAS 关机也能正常浏览与播放。" />

                <!-- 代理访问 API（仅直连模式显示）：源站直连失败/过慢时按顺序尝试 -->
                <LinearLayout
                    android:id="@+id/proxySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="代理访问 API" />

                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnAddProxy"
                            style="@style/Smbtn"
                            android:text="+ 新增代理"
                            android:textColor="@color/accText" />
                    </LinearLayout>

                    <TextView
                        style="@style/MetaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="源站直连失败或过慢时，按列表顺序依次尝试以下代理（请求方式：代理地址?url=目标地址）" />

                    <LinearLayout
                        android:id="@+id/proxyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ② 播放源与鉴权（手风琴面板）——仅 NAS 同步库模式可见 -->
        <LinearLayout
            android:id="@+id/cardSource"
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hdrSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@null">

                <ImageView
                    android:id="@+id/icSourceHeader"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="7dp"
                    android:src="@drawable/ic_set_source"
                    app:tint="@color/t3"
                    android:contentDescription="播放源" />

                <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="播放源与鉴权" />

                <!-- 固定 SOURCE 文案改为播放源连接测试延迟：进入设置页自动测一次（3s 超时），
                     成功显示 XXms（绿色），失败/超时显示「超时」（灰色），同时作为模块有效状态依据 -->
                <TextView
                    android:id="@+id/tvSourceLatency"
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="检测中" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/arSource"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:tag="ic_chevron_down"
                    app:tint="@color/t3"
                    android:contentDescription="展开" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="VodSync 后端地址，保存后全站接口即时生效。"
                    android:textSize="10.5sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.6" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field">

                    <EditText
                        android:id="@+id/inputBaseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingLeft="12dp"
                        android:paddingRight="48dp"
                        android:background="@null"
                        android:textSize="12sp"
                        android:textColor="@color/t1"
                        android:inputType="textUri"
                        android:maxLines="1" />

                    <!-- 有内容时显示，点击一键清空 -->
                    <ImageView
                        android:id="@+id/btnClearBaseUrl"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:padding="14dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/t3"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="清空后端地址"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API Token" />

                    <TextView
                        style="@style/MetaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="鉴权" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="服务端 v1.5.0+ 默认开启访问控制。在浏览器打开服务面板 → 登录 → 右上角「⚙ 设置」→ 复制 API Token 粘贴到这里。服务器未开启鉴权时可留空。"
                    android:textSize="10.5sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.6" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field">

                    <EditText
                        android:id="@+id/inputToken"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingLeft="12dp"
                        android:paddingRight="48dp"
                        android:background="@null"
                        android:hint="vs_xxxxxxxxxxxx"
                        android:textSize="12sp"
                        android:textColor="@color/t1"
                        android:textColorHint="@color/t3"
                        android:inputType="textVisiblePassword"
                        android:maxLines="1" />

                    <!-- 有内容时显示，点击一键清空 -->
                    <ImageView
                        android:id="@+id/btnClearToken"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:padding="14dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/t3"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="清空 API Token"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/srcStatus"
                    style="@style/MetaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="● 未检测" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_main"
                        android:text="保存"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accInk"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/btnTest"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:layout_marginLeft="10dp"
                        android:gravity="center"
                        android:background="@drawable/bg_smbtn"
                        android:text="测试连接"
                        android:textSize="13sp"
                        android:textColor="@color/t1" />
                </LinearLayout>

                <!-- 已保存播放源：保存成功后自动登记，可切换 / 编辑 / 删除 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已保存播放源" />

                    <TextView
                        android:id="@+id/tvSavedCount"
                        style="@style/MetaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/savedList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvSavedEmpty"
                    style="@style/MetaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="保存成功后会记录在这里（地址 + Token 一并保存），可一键切换、编辑、删除。" />

                <!-- 同步控制台独立页面入口：仅在播放源连接测试成功（模块有效）时显示 -->
                <LinearLayout
                    android:id="@+id/consoleEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnOpenConsole"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:background="@drawable/bg_smbtn"
                        android:text="打开同步控制台  ›"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/accText"
                        android:contentDescription="打开同步控制台" />

                    <TextView
                        style="@style/MetaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textAllCaps="false"
                        android:text="运行概览 · 同步操作 · 暂停控制 · 聚合搜索 · 数据表浏览 · 源站状态 · 日志 · 鉴权 · 词库 · 维护"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 同步控制台已迁为独立页面（SyncConsoleActivity），入口在「播放源与鉴权」面板内，
             仅在播放源连接测试成功时显示。 -->

        <!-- ② 播放偏好（手风琴面板） -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hdrPlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@null">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="7dp"
                    android:src="@drawable/ic_set_play"
                    app:tint="@color/t3"
                    android:contentDescription="播放偏好" />

                <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="播放偏好" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/arPlay"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:tag="ic_chevron_down"
                    app:tint="@color/t3"
                    android:contentDescription="展开" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelPlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="跳过片头：新视频从设定的秒数开始播放（用于跳过片头广告）；跳过片尾：播放到结尾前设定的秒数时自动结束。填 0 表示不跳过，改动即时生效。"
                    android:textSize="10.5sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/inputSkipIntro"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:background="@drawable/bg_field"
                        android:hint="跳过片头（秒）"
                        android:textSize="12sp"
                        android:textColor="@color/t1"
                        android:textColorHint="@color/t3"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/inputSkipEnding"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginLeft="10dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:background="@drawable/bg_field"
                        android:hint="跳过片尾（秒）"
                        android:textSize="12sp"
                        android:textColor="@color/t1"
                        android:textColorHint="@color/t3"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- 播放地址工具条开关：控制播放页（内嵌 + 全屏）是否显示当前播放直链与下载按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="显示播放地址与下载按钮"
                            android:textSize="12.5sp"
                            android:textColor="@color/t1" />

                        <TextView
                            style="@style/MetaLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textAllCaps="false"
                            android:text="开启后播放页显示当前视频连接地址，可复制或调用系统下载"
                            android:lineSpacingMultiplier="1.5" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swStreamTools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:contentDescription="显示播放地址与下载按钮" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ③ 离线与缓存（手风琴面板） -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hdrCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@null">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="7dp"
                    android:src="@drawable/ic_set_cache"
                    app:tint="@color/t3"
                    android:contentDescription="离线与缓存" />

                <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="离线与缓存" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/arCache"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:tag="ic_chevron_down"
                    app:tint="@color/t3"
                    android:contentDescription="展开" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvCacheInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="统计中…"
                    android:textSize="12sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.5" />

                <TextView
                    android:id="@+id/btnClearCache"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_smbtn"
                    android:text="清除首页 / 分类 / 源站缓存"
                    android:textSize="12sp"
                    android:textColor="@color/t1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ⑤ 应用更新（手风琴面板） -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hdrApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@null">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="7dp"
                    android:src="@drawable/ic_set_app"
                    app:tint="@color/t3"
                    android:contentDescription="应用更新" />

                <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="应用更新" />

                <TextView
                    android:id="@+id/tvVersion"
                    style="@style/MetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="v--" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/arApp"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:tag="ic_chevron_down"
                    app:tint="@color/t3"
                    android:contentDescription="展开" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvUpdateHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="读取 GitHub Release 最新版本，可直接下载安装。"
                    android:textSize="10.5sp"
                    android:textColor="@color/t2"
                    android:lineSpacingMultiplier="1.6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_main"
                        android:text="检查更新"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/accInk" />

                    <TextView
                        android:id="@+id/btnReleasePage"
                        style="@style/OpBtn"
                        android:layout_marginLeft="8dp"
                        android:text="发布历史" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/MetaLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:text="夜场 LATE SHOW · 开源影视聚合客户端" />
    </LinearLayout>
    </ScrollView>

    <!-- 回到顶部：滚动超过半屏出现，样式/交互与首页、收藏页同款 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        app:fabCustomSize="40dp"
        app:maxImageSize="20dp"
        app:backgroundTint="@color/ink700"
        app:elevation="6dp"
        android:contentDescription="回到顶部"
        android:visibility="gone" />
</FrameLayout>
