<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="14dp">

    <!-- 封面容器：占位底色；圆角改由 Glide RoundedCorners 烘焙进位图 + 遮罩自带圆角，滚动时零逐帧裁剪开销 -->
    <FrameLayout
        android:id="@+id/coverBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_cover_round"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 封面：竖版海报（宽9:高16） -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="封面" />

        <!-- 顶部遮罩：源站名 + 时间（历史卡片） -->
        <LinearLayout
            android:id="@+id/topMask"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:background="@drawable/mask_top_round"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSrc"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="@color/maskText"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvTopTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:textSize="9sp"
                android:textColor="@color/maskText"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- 底部遮罩：左 = 添加/播放时间，右 = 时长 / 源站 -->
        <LinearLayout
            android:id="@+id/maskBottom"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:background="@drawable/mask_bottom_round"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMaskLeft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="@color/maskText"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvMaskRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:gravity="end"
                android:textSize="9sp"
                android:textColor="@color/maskText"
                android:fontFamily="monospace"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 删除角标（仅收藏/历史卡片，右上角） -->
        <FrameLayout
            android:id="@+id/btnDel"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_chip_dark"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/imgDel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:tag="ic_delete"
                android:contentDescription="删除" />
        </FrameLayout>

        <!-- 备注角标（仅首页卡片，左上角，避开右侧删除位） -->
        <TextView
            android:id="@+id/tvRemark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingRight="6dp"
            android:background="@drawable/bg_chip_dark"
            android:textSize="8.5sp"
            android:textColor="@color/maskText"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 收藏书签角标（仅收藏 Tab 显示，右下角） -->
        <FrameLayout
            android:id="@+id/badgeFav"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_chip_dark"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/imgBadgeFav"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:tag="ic_heart"
                android:contentDescription="已收藏" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minLines="2"
        android:maxLines="2"
        android:lineSpacingExtra="1dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/t1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/coverBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
