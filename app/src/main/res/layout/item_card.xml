<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="15dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:background="@color/ink700"
            android:contentDescription="封面" />

        <!-- 顶部遮罩：源站名 + 播放时间（历史卡片） -->
        <LinearLayout
            android:id="@+id/topMask"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:background="@drawable/mask_top"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSrc"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="8.5sp"
                android:textColor="@color/maskText"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvTopTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8.5sp"
                android:textColor="@color/maskText"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- 底部遮罩（历史进度 / 添加时间） -->
        <TextView
            android:id="@+id/tvBottomMask"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical|left"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:background="@drawable/mask_bottom"
            android:textSize="8.5sp"
            android:textColor="@color/maskText"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 备注角标 -->
        <TextView
            android:id="@+id/tvRemark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingRight="6dp"
            android:background="@drawable/bg_chip_dark"
            android:textSize="8.5sp"
            android:textColor="@color/maskText"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 收藏书签角标 -->
        <FrameLayout
            android:id="@+id/badgeFav"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_chip_dark"
            android:visibility="gone">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark"
                android:tint="@color/acc"
                android:contentDescription="已收藏" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minLines="2"
        android:maxLines="2"
        android:lineSpacingExtra="1dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/t1"
        android:ellipsize="end" />
</LinearLayout>
