<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp">

    <!-- 封面：竖版海报（宽9:高16） -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:background="@color/ink700"
        android:contentDescription="封面"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 顶部遮罩：源站名 + 时间（历史卡片） -->
    <LinearLayout
        android:id="@+id/topMask"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:background="@drawable/mask_top"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/cover"
        app:layout_constraintStart_toStartOf="@id/cover"
        app:layout_constraintEnd_toEndOf="@id/cover">

        <TextView
            android:id="@+id/tvSrc"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="@color/maskText"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvTopTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textSize="9sp"
            android:textColor="@color/maskText"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- 底部遮罩（历史进度 / 收藏信息 / 添加时间） -->
    <TextView
        android:id="@+id/tvBottomMask"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:gravity="center_vertical|left"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:background="@drawable/mask_bottom"
        android:textSize="9sp"
        android:textColor="@color/maskText"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cover"
        app:layout_constraintStart_toStartOf="@id/cover"
        app:layout_constraintEnd_toEndOf="@id/cover" />

    <!-- 备注角标（仅首页卡片，右上角） -->
    <TextView
        android:id="@+id/tvRemark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingRight="6dp"
        android:background="@drawable/bg_chip_dark"
        android:textSize="8.5sp"
        android:textColor="@color/maskText"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/cover"
        app:layout_constraintEnd_toEndOf="@id/cover" />

    <!-- 收藏书签角标（仅收藏 Tab 显示，右下角避开顶部遮罩） -->
    <FrameLayout
        android:id="@+id/badgeFav"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_margin="5dp"
        android:background="@drawable/bg_chip_dark"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cover"
        app:layout_constraintEnd_toEndOf="@id/cover">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_bookmark"
            app:tint="@color/acc"
            android:contentDescription="已收藏" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minLines="2"
        android:maxLines="2"
        android:lineSpacingExtra="1dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/t1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
