<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!--
      使用中标识：6dp 主色圆点，与「已保存播放源」列表（item_saved_source）同一语言。
      非使用中行用 INVISIBLE 占位，保证所有条目左对齐、切换时布局不跳动。
    -->
    <View
        android:id="@+id/proxyDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginRight="9dp"
        android:background="@drawable/dot_acc"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/pUrl"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/t1"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/btnUseProxy"
        style="@style/Smbtn"
        android:text="使用"
        android:textColor="@color/accText" />

    <TextView
        android:id="@+id/btnEditProxy"
        style="@style/Smbtn"
        android:layout_marginLeft="6dp"
        android:text="编辑" />

    <TextView
        android:id="@+id/btnDelProxy"
        style="@style/Smbtn"
        android:layout_marginLeft="6dp"
        android:text="删除"
        android:textColor="@color/bad" />
</LinearLayout>
