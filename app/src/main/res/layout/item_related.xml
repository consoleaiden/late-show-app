<?xml version="1.0" encoding="utf-8"?>
<!-- 相关推荐卡片（横向滚动）：海报 9:16 + 相关度角标 + 两行标题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="10dp">

    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="178dp"
        android:background="@drawable/bg_cover_round"
        android:clipToOutline="true">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/relCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="推荐封面" />

        <!-- 相关度：score>0 才显示（服务端兜底链的条目没有真实分数） -->
        <TextView
            android:id="@+id/relScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_score_chip"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/maskText"
            android:fontFamily="monospace"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/relName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.12"
        android:textSize="12sp"
        android:textColor="@color/heroT1" />
</LinearLayout>
