<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!--
              使用中标识：6dp 主色圆点（与主页源站列表 item_source_menu 的选中圆点同一语言）。
              非使用中行用 INVISIBLE 占位，保证所有条目名称左对齐、切换时布局不跳动。
            -->
            <View
                android:id="@+id/sDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginRight="9dp"
                android:background="@drawable/dot_acc"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/sName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/t1"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/sUrl"
            style="@style/MetaLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnUse"
        style="@style/Smbtn"
        android:text="使用"
        android:textColor="@color/accText" />

    <TextView
        android:id="@+id/btnEditSource"
        style="@style/Smbtn"
        android:layout_marginLeft="6dp"
        android:text="编辑" />

    <TextView
        android:id="@+id/btnDelSource"
        style="@style/Smbtn"
        android:layout_marginLeft="6dp"
        android:text="删除"
        android:textColor="@color/bad" />
</LinearLayout>
