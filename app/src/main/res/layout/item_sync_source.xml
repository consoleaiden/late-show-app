<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 行1：勾选 + 名称 + 徽标 + 自动同步开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/chk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/t1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pill"
            style="@style/MetaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:drawableStart="@drawable/dot_ok"
            android:drawablePadding="4dp"
            android:text="" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/autoLabel"
            style="@style/MetaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动同步" />

        <Switch
            android:id="@+id/swAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <!-- 行2：slug 元信息 -->
    <TextView
        android:id="@+id/meta"
        style="@style/MetaLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- 行3：进度条 + 百分比 + 操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/pbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/pbar_sync" />

        <TextView
            android:id="@+id/pct"
            style="@style/MetaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:minWidth="86dp"
            android:text="" />

        <TextView
            android:id="@+id/btnSync"
            style="@style/Smbtn"
            android:text="同步"
            android:textColor="@color/acc" />

        <TextView
            android:id="@+id/btnCali"
            style="@style/Smbtn"
            android:layout_marginLeft="6dp"
            android:text="校准" />

        <TextView
            android:id="@+id/btnEdit"
            style="@style/Smbtn"
            android:layout_marginLeft="6dp"
            android:text="编辑"
            android:textColor="@color/acc"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnDel"
            style="@style/Smbtn"
            android:layout_marginLeft="6dp"
            android:text="删除"
            android:textColor="@color/bad"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
