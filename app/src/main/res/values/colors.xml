    <!-- ============ 详情页配色（唯一配置项，明暗主题都是一套深色） ============
         详情页是「看片页」：整页用深色，海报底部的渐变才是从画面自然溶进底色，
         浅色主题下如果用白底，海报边界会像被切了一刀（亮部海报尤其明显）。
         海报底部渐变 = heroBgFade(全透明) → heroBgMid → heroBg(不透明)，
         页面底色同样是 heroBg —— 三者同源，改这里就能整体换掉详情页的过渡色。
         调色时建议 heroBgMid 取 heroBg 的 ~70% 不透明度，过渡才不会出现色阶断层。 -->
    <color name="heroBg">#14171E</color>
    <color name="heroBgMid">#B314171E</color>
    <color name="heroBgFade">#0014171E</color>
    <!-- 详情页文字/容器令牌：深色底上的三级文字 + 卡片面 + 分隔线 -->
    <color name="heroT1">#F3F5F8</color>
    <color name="heroT2">#A6AEBA</color>
    <color name="heroT3">#78818F</color>
    <color name="heroSurface">#1C212A</color>
    <color name="heroLine">#2A313C</color>
    <!-- 深色底上的橙色小字：比 accText(深橙) 亮，暗底对比度达标 -->
    <color name="heroAccText">#FF8A6B</color>
    <!-- 详情页顶部状态栏遮罩：海报顶部的深色过渡 + 滚动后盖住文字的底色 -->
    <color name="heroTopScrim">#B3000000</color>
    <color name="heroTopScrimEnd">#00000000</color>
    <color name="heroRipple">#26FFFFFF</color>
    <!-- 浅色主题专用「橙色文本」：acc 作为小字正文对比度仅 3.1，此色对白底 5.41 / 页面底 4.87 -->
    <color name="accText">#C13A17</color>
    <!-- 按压波纹：浅底用深色 13% 透明度 -->
    <color name="ripple">#22101820</color>
    <color name="rippleOnAcc">#33FFFFFF</color>
