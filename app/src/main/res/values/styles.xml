<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 海报形状（ShapeableImageView）：四角统一 7dp 圆角（原 10dp 缩小三分之一） -->
    <style name="ShapeAppearance.LateShow.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
    </style>

    <style name="ShapeAppearance.LateShow.CoverLg" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
    </style>

    <style name="TabItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clipChildren">false</item>
    </style>

    <style name="TabInner">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:clipChildren">false</item>
    </style>

    <style name="TabIconBox">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:clipChildren">false</item>
    </style>

    <style name="TabGlow">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/bg_nav_glow</item>
        <item name="android:alpha">0</item>
    </style>

    <style name="TabIcon">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="TabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/acc</item>
        <item name="android:alpha">0</item>
    </style>

    <style name="TabIndicator">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:background">@drawable/bg_nav_ind</item>
        <item name="android:alpha">0</item>
    </style>

    <style name="Mono" >
        <item name="android:fontFamily">monospace</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="MetaLabel" parent="Mono">
        <item name="android:textSize">9.5sp</item>
        <item name="android:textColor">@color/t3</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Smbtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/t1</item>
        <item name="android:background">@drawable/bg_smbtn</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t1</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_card_lg</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="OpBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_smbtn</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/t1</item>
    </style>

    <!-- ===================== 弹出层（对话框 / 弹出菜单） ===================== -->

    <!-- 容器形状：8dp 圆角（用户定稿：实机 10px ≈ 8dp）。
         parent="" 避免点分名隐式父级 -->
    <style name="LateShow.DialogShape" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <!-- 对话框容器：MDC 以 backgroundTint + shapeAppearance 程序化构建圆角底（描边不可行，层次靠投影与表面色差） -->
    <style name="LateShow.MaterialAlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/LateShow.DialogShape</item>
        <item name="backgroundTint">@color/ink800</item>
    </style>

    <!-- 主操作按钮：橙色加粗（色取自 colorPrimary=accText，44dp 触控高度） -->
    <style name="LateShow.DialogBtnPrimary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次/中性操作：灰色常规字重，与主操作拉开层次 -->
    <style name="LateShow.DialogBtnSecondary" parent="LateShow.DialogBtnPrimary">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/t2</item>
    </style>

    <!-- 标题：17sp 粗体，与页面 SectionTitle 同阶 -->
    <style name="LateShow.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t1</item>
    </style>

    <!-- 正文：13sp / t2 / 行距 +5dp（发布说明等多行长文更易读） -->
    <style name="LateShow.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/t2</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <!-- 对话框窗口动画：淡入 + 微缩放入场，快速淡出退场（parent="" 避免隐式父级） -->
    <style name="LateShow.DialogAnim" parent="">
        <item name="android:windowShowAnimation">@anim/dialog_in</item>
        <item name="android:windowHideAnimation">@anim/dialog_out</item>
    </style>

    <!-- 弹出菜单（倍速等）：8dp 圆角 + 描边，与对话框 / 源站浮层同档 -->
    <style name="LateShow.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_menu</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
</resources>
