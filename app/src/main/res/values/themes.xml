<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LateShow" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/ink900</item>
        <item name="colorPrimary">@color/acc</item>
        <item name="colorOnPrimary">@color/accInk</item>
        <item name="colorSurface">@color/ink800</item>
        <item name="android:colorBackground">@color/ink900</item>
        <item name="android:statusBarColor">@color/ink900</item>
        <item name="android:navigationBarColor">@color/ink900</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 弹出层统一规范：对话框 / 弹出菜单。
             MaterialAlertDialogBuilder 读的是 materialAlertDialogTheme（不是 alertDialogTheme，那是给系统/AppCompat AlertDialog 用的），
             之前挂错属性导致整套弹层自定义从未生效 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.LateShow.AlertDialog</item>
        <item name="android:popupMenuStyle">@style/LateShow.PopupMenu</item>
    </style>

    <!-- 弹层主题 overlay：颜色令牌走 @color 引用，深浅主题自动适配。
         注意：按钮样式/窗口参数必须设在主题层（appcompat AlertController 从 themed context 读取），
         容器形状/底色则由 alertDialogStyle 指向的样式控制（MDC 程序化构建 MaterialShapeDrawable） -->
    <style name="ThemeOverlay.LateShow.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/LateShow.MaterialAlertDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/LateShow.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/LateShow.DialogBody</item>
        <!-- colorPrimary 驱动主按钮文字色：浅色用深橙 accText（对比度达标） -->
        <item name="colorPrimary">@color/accText</item>
        <!-- 关闭 elevation 染色：M3 Light 默认 elevationOverlayEnabled=true 且 overlay 色 = colorPrimary，
             8dp 投影高度会把 ~13% 的橙色混进容器底色（泛红）。关掉后容器 = 纯 ink800，与设置页卡片同色 -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- 遮罩由默认 0.6 降到 0.45：透出页面内容，观感更柔和 -->
        <item name="android:backgroundDimAmount">0.45</item>
        <!-- 投影：M3 默认之上略加强，配合表面色分层 -->
        <item name="android:windowElevation">8dp</item>
        <!-- 入场淡入 + 微缩放，退场快速淡出 -->
        <item name="android:windowAnimationStyle">@style/LateShow.DialogAnim</item>
        <!-- 按钮层次：主操作橙色加粗，次/中性灰色常规（minHeight 44dp） -->
        <item name="buttonBarPositiveButtonStyle">@style/LateShow.DialogBtnPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/LateShow.DialogBtnSecondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/LateShow.DialogBtnSecondary</item>
    </style>
</resources>
